[Unit]
Description=Cantaloupe IIIF Image Server Service
# Stop retrying after 5 failed starts within 60s instead of looping forever on
# a bad config.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=root

# Change this to your workspace
WorkingDirectory=/root

# start.sh execs the JVM, so systemd's MainPID is the JVM itself.
ExecStart=/root/start.sh
SyslogIdentifier=cantaloupe

# Restart the service on failure
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
